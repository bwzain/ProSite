# CONTACT_FROM=
# Optional; defaults to PROFILE_DATA.email
# CONTACT_TO=

# Optional: share chat/API rate limits across serverless instances
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: trust X-Forwarded-For from a reverse proxy that overwrites the header
# TRUST_X_FORWARDED_FOR=true
