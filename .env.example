# Production origin for canonical URLs, Open Graph, sitemap, and JSON-LD
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

GEMINI_API_KEY=
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Case Studies hub (executive summary + sub-page case studies)
# Share the hub and all subpages with your Notion integration.
NOTION_CASE_STUDIES_HUB_PAGE_ID=3cca1d09-a5f0-8089-a224-eabdf4e9575c

# Netflix discovery dashboard Google Sheet (share link or CSV export URL)
GOOGLE_SHEETS_CSV_URL=

# Resend HTTPS API for the contact form (works on Vercel; SMTP does not)
RESEND_API_KEY=
# Optional; defaults to "William Zain <onboarding@resend.dev>"
# CONTACT_FROM=
# Optional; defaults to PROFILE_DATA.email
# CONTACT_TO=

# Optional: share chat/API rate limits across serverless instances
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: trust X-Forwarded-For from a reverse proxy that overwrites the header
# TRUST_X_FORWARDED_FOR=true
